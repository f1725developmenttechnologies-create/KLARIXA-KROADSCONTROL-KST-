# ============================================================
# KLARIXA KROADSCONTROL (KST)
# Plantilla de variables de entorno
# Copiar a .env y completar con valores reales
# WIPO / NNN / NDA — EinsRos Global Cortex Ultd
# ============================================================

# --- Aplicación ---
APP_NAME=KROADSCONTROL
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=cambiar_por_clave_segura_aleatoria

# --- Base de datos PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kst_user
POSTGRES_PASSWORD=cambiar_password
POSTGRES_DB=kroadscontrol
DATABASE_URL=postgresql+asyncpg://kst_user:cambiar_password@localhost:5432/kroadscontrol

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# --- Modelos IA (endpoints locales vía vLLM) ---
# En producción AMD, apuntan a vLLM corriendo en el droplet
QWEN_CENTRAL_URL=http://localhost:8001/v1
DEEPSEEK_LOGIC_URL=http://localhost:8002/v1
GEMMA_NLP_URL=http://localhost:8003/v1
QWEN_VL_URL=http://localhost:8004/v1
EDGE_MODEL_URL=http://localhost:8005/v1

# --- API Keys (solo si se usa cloud, no vLLM local) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=

# --- Geolocalización ---
H3_RESOLUTION=9
DEFAULT_CITY=Cucuta
DEFAULT_COUNTRY=CO
DEFAULT_LAT=7.8891
DEFAULT_LNG=-72.4967

# --- Pagos (Bre-B Colombia) ---
BREB_API_URL=
BREB_API_KEY=
BREB_MERCHANT_ID=

# --- KSHIELD (seguridad) ---
KSHIELD_TOKEN=cambiar_token_kshield
KSHIELD_GEOFENCE_ENABLED=false
KSHIELD_GEOFENCE_CENTER_LAT=7.8891
KSHIELD_GEOFENCE_CENTER_LNG=-72.4967
KSHIELD_GEOFENCE_RADIUS_KM=50

# --- Observabilidad ---
LOG_LEVEL=INFO
SENTRY_DSN=